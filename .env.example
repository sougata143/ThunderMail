# ─── Database ────────────────────────────────────────────────────
POSTGRES_USER=thundermail
POSTGRES_PASSWORD=change_me_strong_password_here
DATABASE_URL=postgresql://thundermail:change_me_strong_password_here@db:5432/thundermail

# ─── JWT Auth ────────────────────────────────────────────────────
# Must be at least 32 characters, use: openssl rand -base64 48
JWT_SECRET=change_me_in_production_must_be_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── SMTP Relay (port 587 STARTTLS) ──────────────────────────────
# Works with: SendGrid, Brevo, Postmark, OCI Email Delivery, Mailgun
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM=noreply@yourdomain.com

# ─── App ─────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
CORS_ORIGIN=https://yourdomain.com
NODE_ENV=production

# ─── Local Dev (override above for local) ────────────────────────
# DATABASE_URL=postgresql://thundermail:thundermail_secret@localhost:5432/thundermail
# CORS_ORIGIN=http://localhost:5173
# NODE_ENV=development
