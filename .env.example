# ─── Database ────────────────────────────────────────────────────
# REQUIRED: No default is provided. Docker will refuse to start if unset.
# Generate with: openssl rand -base64 32
POSTGRES_USER=thundermail
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
DATABASE_URL=postgresql://thundermail:CHANGE_ME_generate_with_openssl_rand_base64_32@db:5432/thundermail

# ─── JWT Auth ────────────────────────────────────────────────────
# Must be at least 32 characters, use: openssl rand -base64 48
JWT_SECRET=change_me_in_production_must_be_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── SMTP Relay (port 587 STARTTLS) ──────────────────────────────
# Works with: SendGrid, Brevo, Postmark, OCI Email Delivery, Mailgun
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM=noreply@yourdomain.com

# ─── App ─────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
CORS_ORIGIN=https://yourdomain.com
NODE_ENV=production

# ─── Local Dev (override above for local) ────────────────────────
# DATABASE_URL=postgresql://thundermail:<YOUR_PASSWORD>@localhost:5433/thundermail
# CORS_ORIGIN=http://localhost:5173
# NODE_ENV=development

# ─── DBeaver local connection ────────────────────────────────────
# Host: localhost  Port: 5433  DB: thundermail  User: thundermail  Password: <POSTGRES_PASSWORD>

# ─── Inbound Mail Authentication ─────────────────────────────────
# Provider delivering inbound email to ThunderMail: 'webhook' (SendGrid/Mailgun/Postmark)
# or 'smtp' (self-hosted MX with raw SMTP socket — requires mailauth package)
INBOUND_PROVIDER=webhook
# Shared secret sent by the provider in X-Webhook-Secret header.
# Generate with: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=change_me_generate_with_openssl_rand_hex_32
